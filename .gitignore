# Virtual environments
.venv/
.venv-*/
env/
venv/
ENV/

# Python build artifacts
build/
dist/
*.egg-info/
*.egg
*.whl

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# IDE / editor settings
.vscode/
.idea/
*.swp
*.swo

# Environment files
.env
.env.*
# .fab-test/.env.example is a committed template, not a secret -- fab-test
# init scaffolds it beside .fab-test/.gitignore, which is what actually
# keeps a real .fab-test/.env out of git.
!.fab-test/.env.example

# Local test / coverage output
bandit-report.json
bpa-results.json
coverage.json
.coverage
.coverage.*
htmlcov/
apm.lock.yaml
apm.yml
.pytest_cache/
.mypy_cache/
.ruff_cache/
.fab-test-tools/**
# Local analyzer output
fab-test-results/

# A contributor's own fab-test.yml at the repo root. It carries personal
# values (playwright_user_name is a real UPN) and dev-tenant endpoints, so it
# is per-machine, not shared. `fab-test init` scaffolds one; see README.md's
# contributing section. Anchored to the root so fixtures named fab-test.yml
# elsewhere in the tree are unaffected.
/fab-test.yml

# Claude Code worktrees
.claude/worktrees/

# Optional contributor graph and aggregate observations are machine-local.
/.graphify-local/

# Power BI cache files (any folder level)
**/cache.abf

# Power BI Desktop local state (machine-bound signature, model data cache)
**/localSettings.json
**/.pbi/cache.abf
