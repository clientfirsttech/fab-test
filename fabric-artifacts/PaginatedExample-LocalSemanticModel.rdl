  <DataSets>
    <DataSet Name="Table">
      <Query>
        <DataSourceName>PowerQuery</DataSourceName>
        <CommandText>{"QueryName":"Table","MashupDocument":"section Section1;\r\nshared Table = let\r\n  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WMlSKjQUA\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),\r\n  #\"Changed column type\" = Table.TransformColumnTypes(Source, {{\"Column1\", Int64.Type}})\r\nin\r\n  #\"Changed column type\";\r\n","ConnectionOverrides":[],"GatewayObjectId":null,"ParameterDefinitions":[]}</CommandText>
      </Query>
      <Fields>
        <Field Name="Column1">
          <DataField>Column1</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Model">
      <Query>
        <DataSourceName>PowerQuery</DataSourceName>
        <CommandText>{"QueryName":"Model","MashupDocument":"section Section1;\r\nshared Model = let\r\n  Source = AnalysisServices.Database(\"powerbi://api.powerbi.com/v1.0/myorg/fab-test%20%5BDev%5D\", \"Report with Bookmarks - Broken Visuals\"),\r\n  #\"Navigation 1\" = Source{[Id = \"Model\"]}[Data],\r\n  Model = #\"Navigation 1\"{[Id = \"Model\"]}[Data],\r\n  #\"Added items\" = Cube.Transform(Model, {{Cube.AddAndExpandDimensionColumn, \"[Table (2)]\", {\"[Table (2)].[Column X].[Column X]\", \"[Table (2)].[Column Z].[Column Z]\"}, {\"Column X\", \"Column Z\"}}})\r\nin\r\n  #\"Added items\";\r\n","ConnectionOverrides":[{"Path":"powerbi://api.powerbi.com/v1.0/myorg/fab-test%20%5bdev%5d;Report with Bookmarks - Broken Visuals","Kind":"AnalysisServices","Provider":"DmtsFabric","AuthenticationKind":null,"EnvironmentName":null,"ApiName":null,"ConnectionName":"{\"ClusterId\":\"0dea314d-3f99-4512-ac74-8774ddbafedb\",\"DatasourceId\":\"1c68bf84-be9c-47fd-a9c2-bf9db526d4ad\"}","PrivacyGroup":"None","CredentialDetails":{},"Audience":null,"ConnectionParameters":{}}],"GatewayObjectId":null,"ParameterDefinitions":[]}</CommandText>
      </Query>
