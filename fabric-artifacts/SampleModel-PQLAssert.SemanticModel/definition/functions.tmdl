function 'Schema.DEV.Tests' =
		() =>
		UNION (
			PQL.Assert.Tbl.ShouldExist("Schema: MarvelFact table exists", "MarvelFact"),
			PQL.Assert.Tbl.ShouldExist("Schema: DateDim table exists", "DateDim"),
			PQL.Assert.Tbl.ShouldExist("Schema: EyeColorDim table exists", "EyeColorDim"),
			PQL.Assert.Tbl.ShouldExist("Schema: AlignmentDim table exists", "AlignmentDim"),
			PQL.Assert.Tbl.ShouldExist("Schema: MarvelSource table exists", "MarvelSource"),
			PQL.Assert.Tbl.ShouldExist("Schema: DataTypes table exists", "DataTypes"),
			PQL.Assert.Tbl.ShouldExist("Schema: Timezone table exists", "Timezone"),
			PQL.Assert.Col.ShouldExist("Schema: MarvelFact[ID] column exists", "MarvelFact", "ID"),
			PQL.Assert.Col.ShouldExist("Schema: MarvelFact[Name] column exists", "MarvelFact", "Name"),
			PQL.Assert.Col.ShouldExist("Schema: MarvelFact[Appearances] column exists", "MarvelFact", "Appearances"),
			PQL.Assert.Col.ShouldExist("Schema: MarvelFact[DateID] column exists", "MarvelFact", "DateID"),
			PQL.Assert.Col.ShouldExist("Schema: MarvelFact[EyeID] column exists", "MarvelFact", "EyeID"),
			PQL.Assert.Col.ShouldExist("Schema: MarvelFact[AlignmentID] column exists", "MarvelFact", "AlignmentID"),
			PQL.Assert.Col.ShouldExist("Schema: DateDim[DateID] column exists", "DateDim", "DateID"),
			PQL.Assert.Col.ShouldExist("Schema: DateDim[Date] column exists", "DateDim", "Date"),
			PQL.Assert.Col.ShouldExist("Schema: DateDim[Year] column exists", "DateDim", "Year"),
			PQL.Assert.Col.ShouldExist("Schema: EyeColorDim[EyeID] column exists", "EyeColorDim", "EyeID"),
			PQL.Assert.Col.ShouldExist("Schema: EyeColorDim[Eye Color] column exists", "EyeColorDim", "Eye Color"),
			PQL.Assert.Col.ShouldExist("Schema: AlignmentDim[AlignmentID] column exists", "AlignmentDim", "AlignmentID"),
			PQL.Assert.Col.ShouldExist("Schema: AlignmentDim[Alignment] column exists", "AlignmentDim", "Alignment"),
			PQL.Assert.Relationship.ShouldExist(
				"Schema: MarvelFact to DateDim relationship exists",
				"MarvelFact", "DateID", "DateDim", "DateID"
			),
			PQL.Assert.Relationship.ShouldExist(
				"Schema: MarvelFact to EyeColorDim relationship exists",
				"MarvelFact", "EyeID", "EyeColorDim", "EyeID"
			),
			PQL.Assert.Relationship.ShouldExist(
				"Schema: MarvelFact to AlignmentDim relationship exists",
				"MarvelFact", "AlignmentID", "AlignmentDim", "AlignmentID"
			)
		)
	lineageTag: 934c7485-2823-4208-b549-e6e0e90def81

function 'Measures.DEV.Tests' =
		() =>
		VAR _TotalChars = CALCULATE('MarvelFact'[Number of Characters])
		VAR _TitleByDate = CALCULATE('MarvelFact'[Number of Characters Title By Date])
		VAR __GoodFilter = TREATAS({"Good"}, 'AlignmentDim'[Alignment])
		VAR _GoodChars =
			SUMMARIZECOLUMNS(
				__GoodFilter,
				"Number_of_Characters", IGNORE('MarvelFact'[Number of Characters])
			)
		RETURN UNION(
			PQL.Assert.ShouldBeGreaterThan(
				"Measures: Total Number of Characters is greater than 0",
				0,
				_TotalChars
			),
			PQL.Assert.ShouldBeGreaterThan(
				"Measures: Total Characters exceeds Good-aligned count of 4636",
				4636,
				_TotalChars
			),
			PQL.Assert.ShouldEqual(
				"Measures: Number of Good Aligned Characters equals 4636",
				4636,
				_GoodChars
			),
			PQL.Assert.ShouldBeTrue(
				"Measures: Current Date Time should not be null",
				NOT ISBLANK(CALCULATE([Current Date Time]))
			),
			PQL.Assert.ShouldStartWith(
				"Measures: Title By Date starts with 'Number of Characters'",
				"Number of Characters",
				_TitleByDate
			)
		)
	lineageTag: 3bcc41c1-67dc-4bff-8269-c02a462e1187

