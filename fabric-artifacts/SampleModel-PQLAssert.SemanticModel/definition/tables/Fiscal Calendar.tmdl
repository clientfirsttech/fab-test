/// Disconnected fiscal calendar for the SampleModel-DefaultState test bed (PBIR Slicer Default State epic).
/// Fiscal years start in July and are named by their end year: 14 Nov 2026 is FY27, semester FY27-S1, half 2026 H2.
table 'Fiscal Calendar'

	column Date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: [Date]

	column 'Fiscal Year'
		dataType: string
		summarizeBy: none
		sourceColumn: [Fiscal Year]

	column 'Fiscal Semester'
		dataType: string
		summarizeBy: none
		sourceColumn: [Fiscal Semester]
		sortByColumn: 'Fiscal Semester Sort'

	column 'Fiscal Semester Sort'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Fiscal Semester Sort]

	column 'Half Year'
		dataType: string
		summarizeBy: none
		sourceColumn: [Half Year]
		sortByColumn: 'Half Year Sort'

	column 'Half Year Sort'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Half Year Sort]

	partition 'Fiscal Calendar' = calculated
		mode: import
		source =
				GENERATE(
				    CALENDAR(DATE(2024, 7, 1), DATE(2028, 6, 30)),
				    VAR _FiscalYear = YEAR([Date]) + IF(MONTH([Date]) >= 7, 1, 0)
				    VAR _FiscalSemester = IF(MONTH([Date]) >= 7, 1, 2)
				    VAR _Half = IF(MONTH([Date]) <= 6, 1, 2)
				    RETURN
				        ROW(
				            "Fiscal Year", "FY" & RIGHT(_FiscalYear, 2),
				            "Fiscal Semester", "FY" & RIGHT(_FiscalYear, 2) & "-S" & _FiscalSemester,
				            "Fiscal Semester Sort", _FiscalYear * 10 + _FiscalSemester,
				            "Half Year", YEAR([Date]) & " H" & _Half,
				            "Half Year Sort", YEAR([Date]) * 10 + _Half
				        )
				)
