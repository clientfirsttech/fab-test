        </QueryParameters>
        <CommandText>{"QueryName":"RawSourceExample","MashupDocument":"section Section1;\r\nshared WORKSPACE_ID = \"88b5780c-ab04-432a-8d14-e8c8a17c2e2e\" meta [IsParameterQuery = true, IsParameterQueryRequired = false, Type = type text];\r\nshared RawSourceExample = let\n  Source = PowerPlatform.Dataflows([]),\n  #\"Navigation 1\" = Source{[Id = \"Workspaces\"]}[Data],\n  #\"Navigation 2\" = #\"Navigation 1\"{[workspaceId = WORKSPACE_ID]}[Data],\n  #\"Navigation 3\" = #\"Navigation 2\"{[dataflowName = \"RawSourceExample\"]}[Data],\n  Navigation = #\"Navigation 3\"{[entity = \"MarvelSource\", version = \"\"]}[Data]\nin\n  Navigation;\r\n","ConnectionOverrides":[{"Path":"PowerPlatformDataflows","Kind":"PowerPlatformDataflows","Provider":"DmtsFabric","AuthenticationKind":null,"EnvironmentName":null,"ApiName":null,"ConnectionName":"{\"ClusterId\":\"0dea314d-3f99-4512-ac74-8774ddbafedb\",\"DatasourceId\":\"d02f72f4-85d2-4919-b1d9-1012c35a2eeb\"}","PrivacyGroup":"None","CredentialDetails":{},"Audience":null,"ConnectionParameters":{}}],"GatewayObjectId":null,"ParameterDefinitions":[{"Name":"WORKSPACE_ID","Type":"Text"}]}</CommandText>
